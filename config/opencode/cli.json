{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "leader": "\\",
    "input.line.home": "home",
    "input.line.end": "end",
    "input.buffer.home": "ctrl+a",
    "input.buffer.end": "ctrl+e",
    "input.select.line.home": "shift+home",
    "input.select.line.end": "shift+end",
    "input.select.buffer.home": "ctrl+shift+a",
    "input.select.buffer.end": "ctrl+shift+e"
  },
  "terminal": {
    "title": false,
    "copy": "select"
  },
  "plugins": [
    "-opencode.notifications",
    "./tui-plugins/tab-status",
    "./plugins/overshell-v2"
  ],
  "prompt": {
    "paste": "full"
  },
  "attention": {
    "notifications": true
  }
}
